# 使用 `xcrun xcodebuild -showdestinations` 或 `xcrun devicectl list devices`
# 查询真机 UDID。
IOS_DEVICE_UDID=00008150-00152C6A117A401C

# 必须对应 Xcode -> Settings -> Accounts 中已登录且可用的开发团队。
IOS_TEAM_ID=YOUR_TEAM_ID

# 使用属于自己的唯一 Bundle ID 前缀，测试 Runner 会自动追加 .xctrunner。
IOS_WDA_BUNDLE_ID=com.liuxiaoyang.suanniao.WebDriverAgentRunner
